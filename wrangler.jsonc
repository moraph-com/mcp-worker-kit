{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-worker-kit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Expired OAuth rows and old tool-call records are removed once a day (src/oauth.ts daily()).
  "triggers": { "crons": ["17 4 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-worker-kit",
      // `npx wrangler d1 create mcp-worker-kit` prints the id to put here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  "vars": {
    // Sign-in (src/identity.ts). Leave both Access values empty and DEV_LOGIN unset in production until you
    // have chosen an identity provider: with none configured, /mcp works only for the public tools.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
  },

  // Local development only: `wrangler dev` reads .dev.vars, where DEV_LOGIN=1 turns on the name-only dev sign-in.
  // It never works on a hostname other than localhost or 127.0.0.1.
  "dev": { "port": 8787 },
}
